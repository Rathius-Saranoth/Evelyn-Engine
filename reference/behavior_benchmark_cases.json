  "cases": [
    {
      "id": "restraint_opinion",
      "messages": [
        {
          "role": "user",
          "content": "What's your honest take on keeping a daily journal? Just curious what you think."
        }
      ],
      "conditions": [
        {
          "id": "no_tools",
          "kind": "calls_none",
          "category": "restraint",
          "primary": true,
          "label": "Answers directly, no tools"
        }
      ],
      "notes": "Conversational opinion request. Nothing to retrieve or write — a direct reply is correct."
    },
    {
      "id": "proactivity_venting",
      "messages": [
        {
          "role": "user",
          "content": "Long day. Work was exhausting and I'm wrapping up for the night."
