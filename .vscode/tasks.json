{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Evelyn Services",
            "type": "shell",
            "command": "sudo systemctl start ollama evelyn evelyn-tts",
            "problemMatcher": []
        },
        {
            "label": "Stop Evelyn Services",
            "type": "shell",
            "command": "bash scripts/stop_evelyn_services.sh",
            "problemMatcher": []
        },
        {
            "label": "Stop All Services (with Ollama & WAL flush)",
            "type": "shell",
            "command": "bash scripts/stop_evelyn_services.sh --all --checkpoint-wal",
            "problemMatcher": []
        },
        {
            "label": "Restart Evelyn Server",
            "type": "shell",
            "command": "sudo systemctl restart evelyn",
            "problemMatcher": []
        },
        {
            "label": "View Evelyn Logs",
            "type": "shell",
            "command": "journalctl -u evelyn -f --no-pager -n 50",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "View TTS Logs",
            "type": "shell",
            "command": "journalctl -u evelyn-tts -f --no-pager -n 50",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Evelyn Diagnostics & NUMA Status",
            "type": "shell",
            "command": "bash scripts/check_evelyn_status.sh",
            "problemMatcher": []
        },
        {
            "label": "NUMA Memory Allocation",
            "type": "shell",
            "command": "numastat -c ollama evelyn",
            "problemMatcher": []
        },
        {
            "label": "GPU Status",
            "type": "shell",
            "command": "nvidia-smi",
            "problemMatcher": []
        }
    ]
}
