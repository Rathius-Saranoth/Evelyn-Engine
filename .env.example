# =============================================================================
# Evelyn Engine — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env to configure local machine, network, and secret overrides:
#   cp .env.example .env
#
# DO NOT commit your .env file to version control.
# =============================================================================

# API Authentication Key
# EVELYN_API_KEY="your-secret-api-key"

# Server Network & Port Configuration
# EVELYN_PORT=7860
# EVELYN_BIND_HOST="0.0.0.0"
# EVELYN_SERVER_HOST="localhost"

# Remote FLUX.1 Schnell Image Server URL (e.g. if running on dedicated GPU node)
# EVELYN_IMAGE_SERVER_URL="http://image-host.internal:5055"

# Remote Chatterbox TTS Server URL
# EVELYN_TTS_SERVER_URL="http://localhost:5050"

# Allowed CORS Origins (Comma-separated list of extra browser client origins)
# EVELYN_ALLOWED_ORIGINS="http://192.168.1.100:7860,https://my-node.tailscale.net:7860"

# SSL Certificate & Private Key paths (Optional — for direct HTTPS)
# EVELYN_SSL_CERT="server.crt"
# EVELYN_SSL_KEY="server.key"

# --- Identity boundary ---
# Real names live here, never in tracked source. evelyn_config.py falls back to
# generic defaults so a fresh clone runs without exposing anyone's identity.
EVELYN_ASSISTANT_NAME=Evelyn
EVELYN_USER_NAME=User
# Comma-separated alternate spellings of the operator's name, used by migrations.
EVELYN_USER_LEGACY_ALIASES=
# Comma-separated real-world names (family, friends, contacts) that must never be
# committed. scripts/check_privacy_boundary.py fails the hygiene gate on any match.
EVELYN_PRIVATE_NAMES=

# Folders in YOUR vault the librarian should not draw vocabulary from — imported reference
# material, clinical records, anything that nominates someone else's subject matter rather
# than yours. Comma-separated, relative to the vault root, and {USER_NAME} / {ASSISTANT_NAME}
# interpolate so a path can name its owner without that name entering version control.
#
# This is deliberately separate from the structural list in evelyn_config.py: that one is a
# property of how any vault on this engine is laid out, while this one is your own layout and
# should not ship to anyone else.
#
# Exclusion is from the tag audit only. Excluded notes stay indexed and fully retrievable.
#   e.g. EVELYN_VAULT_USER_IGNORE=Reference Library/,{USER_NAME}/Medical/
EVELYN_VAULT_USER_IGNORE=

# --- Autonomous background passes ---
# Each gates one idle-time pass. The value here wins over the default in evelyn_config.py;
# accepted values are true/1/yes/on and false/0/no/off, and anything else falls back to the
# default rather than guessing. Until v000.006.255 these keys were read by nothing, so the
# literals in evelyn_config.py silently won — set one and check it took effect.
CONSOLIDATION_ENABLED=true
FACT_EXTRACTION_ENABLED=true
PROFILE_EVOLUTION_ENABLED=true
AUTO_JOURNAL_ENABLED=true
AMBIENT_REFLECTIONS_ENABLED=true
# The master librarian rewrites vault notes without asking. Default off; run it with
# --dry-run over a handful of notes and read the diff before turning it on.
MASTER_LIBRARIAN_ENABLED=false
# The tag librarian reads vault notes and nominates unregistered subjects for review.
TAG_LIBRARIAN_ENABLED=true
