# =============================================================================
# Evelyn Engine — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env to configure local machine, network, and secret overrides:
#   cp .env.example .env
#
# DO NOT commit your .env file to version control.
# =============================================================================

# API Authentication Key
# EVELYN_API_KEY="your-secret-api-key"

# Server Network & Port Configuration
# EVELYN_PORT=7860
# EVELYN_BIND_HOST="0.0.0.0"
# EVELYN_SERVER_HOST="localhost"

# Remote FLUX.1 Schnell Image Server URL (e.g. if running on dedicated GPU node)
# EVELYN_IMAGE_SERVER_URL="http://image-host.internal:5055"

# Remote Chatterbox TTS Server URL
# EVELYN_TTS_SERVER_URL="http://localhost:5050"

# Allowed CORS Origins (Comma-separated list of extra browser client origins)
# EVELYN_ALLOWED_ORIGINS="http://192.168.1.100:7860,https://my-node.tailscale.net:7860"

# SSL Certificate & Private Key paths (Optional — for direct HTTPS)
# EVELYN_SSL_CERT="server.crt"
# EVELYN_SSL_KEY="server.key"
